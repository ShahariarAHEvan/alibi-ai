# Copy this file to ".env" and fill in your own values. Never commit ".env".

PORT=3000

# --- PayPal SANDBOX (developer.paypal.com > Apps & Credentials, with "Sandbox" selected) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: price in the sandbox (illustrative test price, not a business price)
PRICE_AMOUNT=4.99
PRICE_CURRENCY=USD
# Optional: only needed for webhook reconciliation on a public URL
PAYPAL_WEBHOOK_ID=

# --- AI witnesses ---
# Leave LLM_API_KEY empty to run in clearly-labelled SCRIPTED mode.
LLM_API_KEY=
# "openai-compatible" (default; works with Google AI Studio / Gemini, OpenAI, Groq, ...) or "anthropic"
LLM_PROVIDER=openai-compatible
# Defaults shown for Google AI Studio's OpenAI-compatible endpoint.
# Model names change over time and not every model is open to every account.
# If you get a 404 or "no longer available" error, list the models your key can use
# (GET <LLM_BASE_URL>/models) and pick a current text model.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash
